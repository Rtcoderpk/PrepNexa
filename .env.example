# ---------------------------------------------------------------------------
# PrepNexa — Environment Variables
# Copy to .env.local (or provide via your process manager / deployment).
# The application runs entirely on CLOUD AI APIs — no local AI server, Ollama,
# Qwen, GPU, or model downloads are required. At least one AI provider key must
# be set for AI features to work.
# ---------------------------------------------------------------------------

# Supabase (Auth + PostgreSQL + Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key — REQUIRED only when FEEDBACK_QUEUE=redis (feedback worker
# writes results with an RLS-bypassing client). NEVER expose to the browser.
# Found in Supabase Dashboard → Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# App URL (used for share/PDF links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Ads (optional — free users)
# ---------------------------------------------------------------------------
# Set to "true" once an ad provider is approved (e.g. Google AdSense).
NEXT_PUBLIC_ADS_ENABLED=false

# ---------------------------------------------------------------------------
# Payments — multi-provider (Safepay primary, Pakistan + international)
# ---------------------------------------------------------------------------
# Payment provider: "safepay" (primary) | "stripe" | "manual" (default).
# Premium is activated ONLY via the webhook — never by the frontend.
PAYMENT_PROVIDER=manual
# Safepay environment: "sandbox" (default) or "production".
# Credentials come from your verified Safepay merchant dashboard:
#   secret/public API keys → Developers → API keys
#   webhook shared secret  → Developers → Endpoints → View shared secret
# Register your webhook URL: https://<your-domain>/api/payments/webhook
SAFEPAY_ENV=sandbox
SAFEPAY_SECRET_KEY=
SAFEPAY_PUBLIC_KEY=
SAFEPAY_WEBHOOK_SECRET=
# JazzCash / easypaisa are future additive providers via the same seam.
# Required when PAYMENT_PROVIDER=stripe (international parity path).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Required to confirm manual/offline payments server-side.
MANUAL_PAYMENT_SECRET=

# ---------------------------------------------------------------------------
# Cloud AI providers (server-side ONLY — never exposed to the browser)
# ---------------------------------------------------------------------------
# Primary provider. Free tier allows generous usage. https://console.groq.com
GROQ_API_KEY=
# Secondary provider. https://ai.google.dev
GEMINI_API_KEY=
# Tertiary provider. https://dash.cloudflare.com → Workers AI
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Additional fallback provider. https://openrouter.ai
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Per-user AI usage budget (server-side cost control)
# ---------------------------------------------------------------------------
# Optional guardrails that cap how many AI requests a single user can make in
# a rolling window, protecting your provider free-tier capacity. 0 = disabled.
AI_DAILY_BUDGET=0
AI_HOURLY_BUDGET=0

# ---------------------------------------------------------------------------
# pythonai — (legacy/optional) self-hosted speech + semantic analysis service
# ---------------------------------------------------------------------------
PYTHONAI_URL=http://localhost:8000
# Timeout for transcription (ms). 60s default, up to 300s.
PYTHONAI_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Rate limiting + background queue (Redis, optional)
# ---------------------------------------------------------------------------
# "memory" (single instance, no deps) or "redis" (shared across instances).
RATE_LIMIT_STORE=memory
# Required when RATE_LIMIT_STORE=redis. Example: redis://localhost:6379
REDIS_URL=

# Feedback queue: "off" (inline, synchronous) or "redis" (enqueue + worker).
FEEDBACK_QUEUE=off
# Secret the feedback worker must send as `x-worker-secret` (self-hosted PM2/
# container drain). For Vercel Cron — which cannot set custom headers — point the
# cron path at `/api/feedback-worker?secret=<this value>` instead. Set the cron
# path in the Vercel project (Dashboard → Settings → Cron Jobs), never committed.
FEEDBACK_WORKER_SECRET=