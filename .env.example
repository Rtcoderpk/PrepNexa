# ---------------------------------------------------------------------------
# InterviewIQ AI — Environment Variables
# Copy to .env.local (or provide via your process manager / docker-compose).
# No cloud LLM keys are required — the AI runs locally via Ollama.
# ---------------------------------------------------------------------------

# Supabase (Auth + PostgreSQL + Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key — REQUIRED only when FEEDBACK_QUEUE=redis (feedback worker
# writes results with an RLS-bypassing client). NEVER expose to the browser.
# Found in Supabase Dashboard → Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# App URL (used for share/PDF links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Payments — multi-provider (Safepay primary, Pakistan + international)
# ---------------------------------------------------------------------------
# Payment provider: "safepay" (primary) | "stripe" | "manual" (default).
# Premium is activated ONLY via the webhook — never by the frontend.
PAYMENT_PROVIDER=manual
# Safepay environment: "sandbox" (default) or "production".
# Credentials come from your verified Safepay merchant dashboard:
#   secret/public API keys → Developers → API keys
#   webhook shared secret  → Developers → Endpoints → View shared secret
# Register your webhook URL: https://<your-domain>/api/payments/webhook
SAFEPAY_ENV=sandbox
SAFEPAY_SECRET_KEY=
SAFEPAY_PUBLIC_KEY=
SAFEPAY_WEBHOOK_SECRET=
# JazzCash / easypaisa are future additive providers via the same seam.
# Required when PAYMENT_PROVIDER=stripe (international parity path).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Required to confirm manual/offline payments server-side.
MANUAL_PAYMENT_SECRET=

# ---------------------------------------------------------------------------
# pythonai — self-hosted speech + semantic analysis service (FastAPI)
# ---------------------------------------------------------------------------
PYTHONAI_URL=http://localhost:8000
# Timeout for transcription (ms). 60s default, up to 300s.
PYTHONAI_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Rate limiting + background queue (Redis, optional)
# ---------------------------------------------------------------------------
# "memory" (single instance, no deps) or "redis" (shared across instances).
RATE_LIMIT_STORE=memory
# Required when RATE_LIMIT_STORE=redis. Example: redis://localhost:6379
REDIS_URL=

# Feedback queue: "off" (inline, synchronous) or "redis" (enqueue + worker).
FEEDBACK_QUEUE=off
# Secret the feedback worker must send as `x-worker-secret`.
FEEDBACK_WORKER_SECRET=
